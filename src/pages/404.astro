---
import '../index.css';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/jpeg" href="/logo-small.jpg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Página no encontrada - Synergia" />
    <meta name="theme-color" content="#0a0a0f" />
    <title>404 // Nodo No Encontrado - Synergia</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800;900&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <style>
      .error-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 70vh;
        text-align: center;
        padding: 40px 24px;
        position: relative;
        z-index: 10;
      }

      .error-code {
        font-family: 'Orbitron', sans-serif;
        font-size: clamp(6rem, 15vw, 12rem);
        font-weight: 900;
        line-height: 1;
        letter-spacing: -0.05em;
        background: linear-gradient(135deg, var(--accent) 30%, var(--secondary) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 0 0 40px rgba(0, 240, 140, 0.2);
        animation: glitch-flicker 3s infinite;
        margin-bottom: 20px;
      }

      .error-title {
        font-family: 'Orbitron', sans-serif;
        font-size: clamp(1.2rem, 4vw, 2.2rem);
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--foreground);
        margin-bottom: 16px;
        text-transform: uppercase;
      }

      .error-desc {
        max-width: 580px;
        font-size: 1.05rem;
        line-height: 1.6;
        color: var(--muted-foreground);
        margin-bottom: 40px;
      }

      .error-actions {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        justify-content: center;
      }

      @keyframes glitch-flicker {
        0%, 100% { opacity: 1; filter: hue-rotate(0deg); }
        45% { opacity: 1; }
        46% { opacity: 0.85; filter: hue-rotate(15deg) contrast(1.2); }
        47% { opacity: 1; }
        85% { opacity: 1; }
        86% { opacity: 0.7; filter: hue-rotate(-10deg) saturate(1.5); }
        87% { opacity: 1; }
      }
    </style>
  </head>
  <body>
    <div class="scanline-overlay" aria-hidden="true" />
    <div class="vignette-overlay" aria-hidden="true" />
    
    <Navbar client:load />

    <main class="error-container container">
      <div class="error-code">404</div>
      <h1 class="error-title">NODO NO ENCONTRADO</h1>
      <p class="error-desc font-body">
        La dirección a la que estás intentando acceder no forma parte del protocolo de consenso Synergia o ha sido depurada por falta de actividad en la red.
      </p>
      <div class="error-actions">
        <a href="/" class="btn btn--primary btn--animated font-display">
          <span>VOLVER AL NODO PRINCIPAL</span>
        </a>
      </div>
    </main>

    <Footer client:load hideCTA={true} />
  </body>
</html>