---
import '../index.css';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/jpeg" href={`${import.meta.env.BASE_URL}logo-small.jpg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Página no encontrada - Synergia" />
    <meta name="theme-color" content="#0a0a0f" />
    <title>404 // Nodo No Encontrado - Synergia</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      .error-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 70vh;
        text-align: center;
        padding: 40px 24px;
        position: relative;
        z-index: 10;
      }

      .error-code {
        font-family: var(--font-primary);
        font-size: clamp(6rem, 15vw, 12rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.05em;
        color: var(--foreground);
        margin-bottom: 20px;
      }

      .error-title {
        font-family: var(--font-primary);
        font-size: clamp(1.2rem, 4vw, 2.2rem);
        font-weight: 500;
        letter-spacing: 0.1em;
        color: var(--foreground);
        margin-bottom: 16px;
        text-transform: uppercase;
      }

      .error-desc {
        max-width: 580px;
        font-size: 15px;
        line-height: 1.75;
        color: var(--gray);
        margin-bottom: 40px;
      }

      .error-actions {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        justify-content: center;
      }
    </style>
  </head>
  <body>
    
    <Navbar client:load />

    <main class="error-container container">
      <div class="error-code">404</div>
      <h1 class="error-title">NODO NO ENCONTRADO</h1>
      <p class="error-desc font-body">
        La dirección a la que estás intentando acceder no forma parte del protocolo de consenso Synergia o ha sido depurada por falta de actividad en la red.
      </p>
      <div class="error-actions">
        <a href={import.meta.env.BASE_URL} class="btn btn--primary">
          <span>VOLVER AL NODO PRINCIPAL</span>
        </a>
      </div>
    </main>

    <Footer client:load hideCTA={true} />
  </body>
</html>