---
import '../index.css';
import Navbar from '../components/Navbar';
import EconomicModel from '../components/EconomicModel';
import DonationWidget from '../components/DonationWidget';
import Footer from '../components/Footer';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/jpeg" href="/logo-small.jpg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Simulador de Liquidación Económica y Coste Físico de Hardware - Synergia" />
    <meta name="theme-color" content="#0a0a0f" />
    <title>Simulador de Créditos // Synergia</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      .page-wrap {
        padding-top: 110px;
      }
      .back-nav {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px 24px 0;
      }
      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-primary);
        font-size: 13.5px;
        font-weight: 500;
        color: var(--gray);
        text-decoration: none;
        transition: color 150ms ease;
      }
      .back-link:hover {
        color: var(--blue);
      }
    </style>
  </head>
  <body>
    <Navbar client:load />

    <div class="page-wrap">
      <div class="back-nav">
        <a href="/" class="back-link">
          ← Volver a la página principal
        </a>
      </div>
      <EconomicModel client:load />
    </div>

    <DonationWidget client:load />

    <Footer client:load hideCTA={true} />
  </body>
</html>